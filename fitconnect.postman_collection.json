{
  "info": {
    "_postman_id": "f1t-ccnn-ct-2026-0001",
    "name": "FitConnect — Réservation de cours de sport",
    "description": "Collection Postman complète du TP FitConnect (module 13).\n\nPlateforme de réservation de cours en 4 microservices (class / booking / payment / notification) derrière l'api-gateway (port 8080).\n\nScénarios couverts :\n- Gestion des cours (CRUD + filtres + pagination)\n- Réservation (Saga Reserve-Now-Pay-Later)\n- Paiement (accepter < 100 €, refuser >= 100 €)\n- Annulation dans les délais (remboursement + libération des places)\n- Scénarios d'erreur (surréservation 409, paiement refusé)\n\nLes requêtes enchaînent automatiquement la création -> réservation -> paiement -> annulation via des variables de collection (classId, classPleinId, bookingId).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "classId", "value": "" },
    { "key": "classPleinId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "bookingGrosseId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Gestion des cours (class-service)",
      "item": [
        {
          "name": "Créer un cours (YOGA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"id présent\", () => pm.expect(pm.response.json().id).to.be.a('number'));",
                  "pm.collectionVariables.set('classId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yoga du matin\",\n  \"description\": \"Cours de yoga doux pour débutants\",\n  \"instructor\": \"Marie\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"YOGA\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 20.00,\n  \"dateTime\": \"2026-09-20T10:00:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/classes", "host": ["{{baseUrl}}"], "path": ["api", "classes"] }
          }
        },
        {
          "name": "Créer un cours presque plein (CROSSFIT, max 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('classPleinId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CrossFit Intense\",\n  \"description\": \"Séance de crossfit\",\n  \"instructor\": \"Lucas\",\n  \"gymLocation\": \"Lyon\",\n  \"category\": \"CROSSFIT\",\n  \"level\": \"ADVANCED\",\n  \"durationMinutes\": 45,\n  \"maxParticipants\": 5,\n  \"price\": 35.00,\n  \"dateTime\": \"2026-09-21T18:00:00\",\n  \"currentParticipants\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/classes", "host": ["{{baseUrl}}"], "path": ["api", "classes"] }
          }
        },
        {
          "name": "Lister les cours (filtres + pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?category=YOGA&level=BEGINNER&page=0&size=10&sort=dateTime,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [
                { "key": "category", "value": "YOGA" },
                { "key": "level", "value": "BEGINNER" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "dateTime,asc" }
              ]
            }
          }
        },
        {
          "name": "Rechercher un cours (search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/search?location=Paris&instructor=Marie",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "search"],
              "query": [
                { "key": "location", "value": "Paris" },
                { "key": "instructor", "value": "Marie" }
              ]
            }
          }
        },
        {
          "name": "Détails d'un cours",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/classes/{{classId}}", "host": ["{{baseUrl}}"], "path": ["api", "classes", "{{classId}}"] }
          }
        }
      ]
    },
    {
      "name": "2. Réservation (booking-service — Saga)",
      "item": [
        {
          "name": "Réserver 2 places (PENDING_PAYMENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"statut PENDING_PAYMENT\", () => pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT'));",
                  "pm.collectionVariables.set('bookingId', pm.response.json().id);",
                  "pm.collectionVariables.set('bookingReference', pm.response.json().bookingReference);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": {{classId}},\n  \"numberOfSpots\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Récupérer la réservation",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Réservations d'un utilisateur",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/user/1", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "user", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Paiement et confirmation",
      "item": [
        {
          "name": "Confirmer le paiement (< 100 € → accepté)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"statut CONFIRMED\", () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "confirm"] }
          }
        },
        {
          "name": "Vérifier le statut CONFIRMED",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Paiement >= 100 € (simulation échec)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"statut FAILED (paiement refusé)\", () => pm.expect(pm.response.json().status).to.eql('FAILED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"userId\": 1,\n  \"amount\": 100.00,\n  \"paymentMethod\": \"PAYPAL\",\n  \"transactionId\": \"txn_refuse\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments", "host": ["{{baseUrl}}"], "path": ["api", "payments"] }
          }
        }
      ]
    },
    {
      "name": "4. Annulation (dans les délais)",
      "item": [
        {
          "name": "Annuler la réservation confirmée",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"statut CANCELLED\", () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "cancel"] }
          }
        },
        {
          "name": "Vérifier le remboursement (payment-service)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/booking/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "booking", "{{bookingId}}"] }
          }
        },
        {
          "name": "Vérifier les places libérées (class-service)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/classes/{{classId}}", "host": ["{{baseUrl}}"], "path": ["api", "classes", "{{classId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Scénarios d'erreur",
      "item": [
        {
          "name": "Surréservation → 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"userEmail\": \"alice@example.com\",\n  \"userName\": \"Alice Smith\",\n  \"classId\": {{classPleinId}},\n  \"numberOfSpots\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Cours inexistant → 409 (InvalidBookingOperation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"userEmail\": \"bob@example.com\",\n  \"userName\": \"Bob Smith\",\n  \"classId\": 999999,\n  \"numberOfSpots\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        }
      ]
    },
    {
      "name": "6. Notifications (notification-service)",
      "item": [
        {
          "name": "Historique des notifications d'un utilisateur",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/notifications/user/1", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "user", "1"] }
          }
        },
        {
          "name": "Notifications en attente (scheduler)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/notifications/pending", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "pending"] }
          }
        }
      ]
    }
  ]
}
